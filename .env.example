# LLM provider: auto, huggingface_local, huggingface_hub, ollama, or gemini
LLM_PROVIDER=auto

# Hugging Face / Open-source LLM configuration
HF_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_API_TOKEN=

# Optional Ollama local open-source LLM server
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# Dense embeddings & FAISS retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_FILE_SIZE_MB=20
TOP_K=6
